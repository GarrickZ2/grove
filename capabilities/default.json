{
  "$schema": "https://schema.tauri.app/config/2/schema.json",
  "identifier": "default",
  "description": "Main window capabilities — full app surface (shell, file dialog, devtools).",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": ["http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "drag:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "shell:allow-open",
    "updater:default",
    "allow-open-external-url",
    "allow-download-file-dialog",
    "allow-save-bytes-dialog",
    "allow-resolve-external-drag-path",
    "allow-toggle-devtools",
    "allow-toggle-main-window-visibility",
    "allow-toggle-tray-popover-visibility",
    "allow-tray-update-theme-icons"
  ]
}
