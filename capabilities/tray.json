{
  "$schema": "https://schema.tauri.app/config/2/schema.json",
  "identifier": "tray-popover",
  "description": "Menubar tray popover — invokes tray_* commands only; no event listening.",
  "windows": ["tray-popover"],
  "local": true,
  "remote": {
    "urls": ["http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "allow-tray-resolve-permission",
    "allow-tray-open-main",
    "allow-tray-open-settings",
    "allow-tray-open-task",
    "allow-tray-take-pending-navigate",
    "allow-tray-set-pinned",
    "allow-tray-is-pinned",
    "allow-tray-update-theme-icons",
    "allow-toggle-tray-popover-visibility"
  ]
}
