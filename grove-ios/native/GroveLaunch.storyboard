<?xml version="1.0" encoding="UTF-8"?>
<!-- The first frame of the app: the same mark on the same background as the
     loading screen the page draws next (grove-web/src/ios/ios-splash.css). -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="17150" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="GLV-vc-001">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="17122"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="GLV-sc-001">
            <objects>
                <viewController id="GLV-vc-001" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="GLV-vw-001">
                        <rect key="frame" x="0.0" y="0.0" width="414" height="896"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" image="LaunchIcon" translatesAutoresizingMaskIntoConstraints="NO" id="GLV-iv-001">
                                <rect key="frame" x="159" y="400" width="96" height="96"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="96" id="GLV-cw-001"/>
                                    <constraint firstAttribute="height" constant="96" id="GLV-ch-001"/>
                                </constraints>
                                <userDefinedRuntimeAttributes>
                                    <userDefinedRuntimeAttribute type="number" keyPath="layer.cornerRadius">
                                        <integer key="value" value="22"/>
                                    </userDefinedRuntimeAttribute>
                                </userDefinedRuntimeAttributes>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="GLV-iv-001" firstAttribute="centerX" secondItem="GLV-vw-001" secondAttribute="centerX" id="GLV-cx-001"/>
                            <constraint firstItem="GLV-iv-001" firstAttribute="centerY" secondItem="GLV-vw-001" secondAttribute="centerY" constant="-10" id="GLV-cy-001"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="GLV-fr-001" userLabel="First Responder" customClass="UIResponder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchIcon" width="96" height="96"/>
        <namedColor name="LaunchBackground">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </namedColor>
    </resources>
</document>
